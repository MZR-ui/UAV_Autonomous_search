<launch>
    <!-- VINS-Fusion 双目惯性（EuRoC MAV 数据集）
         用法：
           终端1: rosbag play data/machine_hall/MH_01_easy/MH_01_easy.bag
           终端2: roslaunch vins vins_euroc.launch -->
    <node name="vins_estimator" pkg="vins" type="vins_node" output="screen"
          args="$(find vins)/config/euroc/euroc_stereo_imu_config.yaml" />
</launch>
